{
  "version": "0.2",
  "language": "en,zh-CN",
  "useGitignore": true,
  "enableGlobDot": true,
  "files": ["**/*.{md,mdx,ts,tsx,json,yml,yaml}"],
  "ignorePaths": [
    "build/**",
    ".docusaurus/**",
    "node_modules/**",
    "package-lock.json",
    "static/**"
  ],
  "words": [
    "Alibaba",
    "Algolia",
    "Aone",
    "Ajv",
    "camelcase",
    "CODEOWNERS",
    "davidanson",
    "Docusaurus",
    "DocSearch",
    "esbenp",
    "frontmatter",
    "GitLab",
    "MaxCompute",
    "Phosphor",
    "MDX",
    "ODPS",
    "hideable",
    "quickstart",
    "sidebars",
    "sql",
    "tsbuildinfo"
  ]
}

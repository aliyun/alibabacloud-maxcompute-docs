{
  "name": "maxcompute-docs",
  "version": "0.1.0",
  "description": "MaxCompute 多产品文档平台",
  "private": true,
  "scripts": {
    "prestart": "npm run generate:search",
    "start": "docusaurus start",
    "prebuild": "npm run generate:search",
    "build": "docusaurus build",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "docusaurus": "docusaurus",
    "typecheck": "tsc --noEmit",
    "generate:search": "node scripts/generate-search-index.mjs",
    "check:search": "node scripts/generate-search-index.mjs --check",
    "check:docs": "node scripts/validate-docs.mjs",
    "check:products": "node scripts/validate-products.mjs",
    "new:product": "node scripts/create-product.mjs",
    "lint:md": "markdownlint-cli2",
    "spellcheck": "cspell --no-progress --no-summary \"**/*.{md,mdx,ts,tsx,json,yml,yaml}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run lint:md && npm run spellcheck && npm run check:docs && npm run check:products && npm run check:search && npm run typecheck",
    "ci": "npm run validate && npm run build",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "@phosphor-icons/react": "2.1.10",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "ajv": "8.20.0",
    "cspell": "^9.0.0",
    "js-yaml": "4.3.2",
    "markdownlint-cli2": "^0.20.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.17.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.6.2",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.alibaba-inc.com/odps/maxcompute-docs.git"
  }
}

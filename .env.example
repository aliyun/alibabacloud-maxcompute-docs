# 本地默认地址。Aone Pages 正式构建设置为 https://maxcompute-docs.io.alibaba-inc.com。
DOCS_SITE_URL=http://localhost:3000

# 子路径部署时使用带前后斜线的值，例如 /maxcompute-docs/。
DOCS_BASE_URL=/

# 本地仓库已有提交记录时，可设置为 true 显示最后更新人和时间。
DOCS_SHOW_LAST_UPDATE=false

# Algolia DocSearch 参数全部配置后，站点才启用搜索。
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=

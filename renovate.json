{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Docusaurus packages must be upgraded atomically",
      "matchPackageNames": ["/^@docusaurus\\//"],
      "groupName": "Docusaurus",
      "rangeStrategy": "pin"
    },
    {
      "description": "Do not automerge major dependency updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.alibaba-inc.com/odps/maxcompute-docs/-/raw/master/config/components.schema.json",
  "title": "MaxCompute documentation component registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "path",
          "href",
          "category",
          "status",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 8
          },
          "path": {
            "type": "string",
            "pattern": "^docs/components/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "href": {
            "type": "string",
            "pattern": "^/docs/components/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "category": {
            "enum": ["core", "development", "integration", "operations"]
          },
          "status": {
            "enum": ["draft", "published", "deprecated"]
          },
          "owner": {
            "type": "string",
            "pattern": "^@[^\\s]+$"
          }
        }
      }
    }
  }
}

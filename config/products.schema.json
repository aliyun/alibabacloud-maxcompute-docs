{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.alibaba-inc.com/odps/maxcompute-docs/-/raw/master/config/products.schema.json",
  "title": "MaxCompute documentation product registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "products"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "shortName",
          "description",
          "path",
          "href",
          "status",
          "owner",
          "icon",
          "accent",
          "featured",
          "navigation"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "shortName": {"type": "string", "minLength": 1, "maxLength": 40},
          "description": {"type": "string", "minLength": 8, "maxLength": 160},
          "path": {
            "type": "string",
            "pattern": "^docs/products/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "href": {
            "type": "string",
            "pattern": "^/docs/products/[a-z0-9]+(?:-[a-z0-9]+)*/$"
          },
          "status": {"enum": ["draft", "published", "deprecated"]},
          "owner": {"type": "string", "pattern": "^@[^\\s]+$"},
          "icon": {"enum": ["terminal", "robot", "desktop", "cube"]},
          "accent": {"enum": ["orange", "blue", "violet", "green"]},
          "featured": {"type": "boolean"},
          "navigation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "href"],
              "properties": {
                "label": {"type": "string", "minLength": 1, "maxLength": 40},
                "href": {
                  "type": "string",
                  "pattern": "^/docs/products/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*/$"
                }
              }
            }
          }
        }
      }
    }
  }
}
